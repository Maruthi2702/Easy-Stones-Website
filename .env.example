# Environment Variables Template
# Copy this file to .env and fill in your values

# Backend API URL (update after deploying backend)
VITE_API_URL=http://localhost:3001

# Signs every login token the API issues — required, the server refuses to
# start without it. Generate one with: openssl rand -base64 48
JWT_SECRET=

# For production, update to your deployed backend URL:
# VITE_API_URL=https://your-backend-url.railway.app

# Google Maps — needed by the Route Planner and by customer geocoding.
#
# Two keys rather than one, because they are exposed differently: the VITE_ one
# is compiled into the browser bundle and can only be protected by an HTTP
# referrer restriction, while the geocoding key is used server-side and should be
# restricted by IP. One key works for both if you would rather start simple; the
# server falls back to GOOGLE_MAPS_API_KEY when GOOGLE_GEOCODING_API_KEY is unset.
#
# Enable BOTH of these APIs on the key in Google Cloud Console — a Maps key does
# not cover geocoding:
#   • Maps JavaScript API   (draws the map)
#   • Geocoding API         (turns customer addresses into coordinates)
#
# VITE_GOOGLE_MAPS_API_KEY=AIza...        # browser: referrer-restricted
# VITE_GOOGLE_MAP_ID=...                   # optional: Cloud Console Map ID (Vector) — smooth zoom/pinch on the Route Planner
# GOOGLE_GEOCODING_API_KEY=AIza...        # server:  IP-restricted
# GEOCODE_ALERT_EMAIL=you@example.com     # emailed when a new customer's map lookup fails (comma-separate several)

# Email: Amazon SES first, Gmail SMTP as the backup (src/services/emailService.ts).
# SES is off until SES_FROM_EMAIL is set; credentials are the AWS_* keys (Render)
# or the function's role (AWS). Leave them unset locally to send only through SMTP.
# SES_FROM_EMAIL=noreply@easystones.com
# SES_CONFIGURATION_SET=easy-surfaces-dev-email
# SES_REGION=us-east-2

# SMTP backup (a Gmail app password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# ERP import (src/services/erpImportService.js) — Playwright logs into the
# ERP's web UI with these since it has no API. Requires `npx playwright
# install chromium` once locally (and on the Render build if this ships).
# ERP_URL=https://your-erp.example.com
# ERP_USERNAME=your-erp-username
# ERP_PASSWORD=your-erp-password

# File storage — src/services/fileStore.ts. Default: Cloudinary (CLOUDINARY_* above/below).
# FILE_STORE=s3 sends new uploads to S3 behind CloudFront (the aws-infra files stack):
# FILE_STORE=s3
# FILES_BUCKET=easy-surfaces-dev-website-files-533848567248-us-east-2
# FILES_CDN_URL=https://dxxxxxxxxxxxxx.cloudfront.net
# VITE_FILES_CDN_URL=https://dxxxxxxxxxxxxx.cloudfront.net
# AWS_REGION=us-east-2
# AWS_ACCESS_KEY_ID=…         (the files-uploader IAM user's key; never commit it)
# AWS_SECRET_ACCESS_KEY=…

